# ---- Telegram ----
# Token from @BotFather
BOT_TOKEN=
# Bot username without the @, e.g. BattleBot
BOT_USERNAME=
# Numeric chat id of the channel users must subscribe to (e.g. -1001234567890)
CHANNEL_ID=
# Public @username of the channel, without the @ (used for the "subscribe" deep link)
CHANNEL_USERNAME=
# URL where the Mini App (apps/web) is hosted, used to build deep links and by BotFather
MINI_APP_URL=https://your-domain.example.com

# ---- Database ----
DATABASE_URL=postgresql://battle:battle@localhost:5432/battle?schema=public

# ---- Security ----
# Secret used to sign session JWTs issued after Telegram initData verification. Generate with: openssl rand -hex 32
JWT_SECRET=
# Max age (seconds) Telegram initData's auth_date may be behind "now" before it's rejected
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ---- App ----
# Public URL of the API (apps/api)
APP_URL=http://localhost:4000
NODE_ENV=development
PORT=4000

# ---- Game balance (optional overrides; see packages/config for defaults) ----
DAILY_FREE_ATTEMPTS=3
GAME_DURATION_SECONDS=10
SEASON_DURATION_DAYS=14
REFERRAL_BONUS_ATTEMPTS=1

# ---- Dev only ----
# When set (non-production only), /api/auth/telegram accepts a fake initData payload
# for a user with this Telegram id, so the web app can be developed outside Telegram.
DEV_TELEGRAM_USER_ID=
