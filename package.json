{
  "name": "battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BATTLE — competitive Telegram Mini App",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:web": "pnpm --filter @battle/web dev",
    "dev:api": "pnpm --filter @battle/api dev",
    "dev:bot": "pnpm --filter @battle/bot dev",
    "build": "pnpm -r typecheck && pnpm --filter @battle/api build && pnpm --filter @battle/bot build && pnpm --filter @battle/web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "dotenv -e .env -- pnpm --filter @battle/api exec prisma generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @battle/api exec prisma migrate dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter @battle/api exec prisma migrate deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @battle/api exec tsx prisma/seed/index.ts",
    "db:studio": "dotenv -e .env -- pnpm --filter @battle/api exec prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
